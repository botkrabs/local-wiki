# ZIM data — lives in <project>/wiki_zim/ (on the original deployment that
# dir is a symlink to /mnt/shared/wiki_zim/; big files stay off the WSL root)
*.zim
wiki_zim
# ...but commit the wikipedia.zim symlink (relative pointer into wiki_zim/;
# resolves once a ZIM lands at wiki_zim/wikipedia_nopic.zim)
!wikipedia.zim

# runtime
run.pid
server.log
__pycache__/
*.pyc

# manual ZIM swaps keep one .bak of the previous archive
*.bak

# kept locally (untracked), not shipped
refresh_zim.py    # single-purpose 50 GB English updater
bench_http.py     # e2e latency probe (README curl wire-check covers it)
INCIDENT_2026-08-28.md  # incident write-up of the original deployment
